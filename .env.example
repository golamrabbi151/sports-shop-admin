# ─────────────────────────────────────────────────────────────
# KhelaBD Admin — environment variables. Copy to .env.local
# ─────────────────────────────────────────────────────────────

# Same backend as the storefront (admin routes live under /admin/*)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# true  -> built-in demo data (saved in this browser's localStorage)
# false -> call the real API
NEXT_PUBLIC_USE_MOCK_API=true

# Public URL of the customer storefront (for "View on store" links & images)
NEXT_PUBLIC_STORE_URL=https://sports-shop-henna.vercel.app/

# Public URL of this admin panel
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Name of the HttpOnly admin session cookie your backend sets.
# Must be DIFFERENT from the customer cookie.
ADMIN_COOKIE_NAME=kb_admin_session

# Log out automatically after this many minutes without activity
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30
